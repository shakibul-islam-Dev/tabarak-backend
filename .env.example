NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# Use `none` (with HTTPS) when the frontend and API are on different sites,
# for example two separate *.vercel.app domains. `lax` is fine for same-site.
AUTH_COOKIE_SAME_SITE=lax

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabarak?schema=public

BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=tabarak <no-reply@tabarak.local>

# `local` writes to UPLOAD_DIR. `vercel-blob` stores images in Vercel Blob and
# is required for durable uploads on Vercel (the token is injected by Vercel
# when a Blob store is connected to the project). Vercel Functions reject
# request bodies larger than 4.5 MB, so keep this below that when deploying.
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
BLOB_READ_WRITE_TOKEN=
MAX_FILE_SIZE=4194304

# Optional seed overrides (used by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@tabarak.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=tabarak Admin

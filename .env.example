NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabark?schema=public

BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Tabark <no-reply@tabark.local>

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Optional seed overrides (used by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@tabark.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Tabark Admin
